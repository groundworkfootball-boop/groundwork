rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ─── Security Foundation ─────────────────────────────────────────────
    // Deny everything bdy default
    match /{document=**} {
      allow read, write: if false;
    }

    // ─── Helper Functions ─────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isClub() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'club';
    }

    function isPlayer() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'player';
    }

    function isGuardian() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'guardian';
    }

    function isVerifiedYouthClub() {
      return isClub() &&
        exists(/databases/$(database)/documents/clubs/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/clubs/$(request.auth.uid)).data.get('verifiedYouth', false) == true;
    }

    // ─── Users ──────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if (isOwner(userId) && 
                    !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'disabled']))
                   || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Player Profiles ─────────────────────────────────────────────────
    match /players/{userId} {
      // Adult players: searchable by clubs, or read by owner / admin
      // Youth players: strictly restricted to owner, verified youth club, guardian, or admin
      allow read: if isOwner(userId) || isAdmin() ||
                  (isClub() && resource.data.searchable == true && resource.data.get('isYouth', false) == false) ||
                  (isVerifiedYouthClub() && resource.data.searchable == true && resource.data.get('isYouth', false) == true && resource.data.get('consentStatus', 'pending') == 'granted') ||
                  (isGuardian() && resource.data.get('guardianEmail', '') == request.auth.token.email);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && 
                    !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified', 'adminNotes', 'score'])
                   || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Guardians ────────────────────────────────────────────────────────
    match /guardians/{guardianId} {
      allow read: if isOwner(guardianId) || isAdmin();
      allow create, update: if isOwner(guardianId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Club Profiles ───────────────────────────────────────────────────
    match /clubs/{clubId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(clubId);
      allow update: if isOwner(clubId) && 
                    !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verificationStatus', 'verifiedAdult', 'verifiedYouth', 'adminNotes'])
                   || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Club Invites & Code Management ──────────────────────────────────
    match /clubInvites/{inviteId} {
      allow read: if isAuthenticated();
      allow create: if isClub() && request.resource.data.clubId == request.auth.uid;
      allow update: if (isClub() && resource.data.clubId == request.auth.uid) || isAuthenticated() || isAdmin();
      allow delete: if (isClub() && resource.data.clubId == request.auth.uid) || isAdmin();
    }

    // ─── Squad Members ────────────────────────────────────────────────────
    match /squadMembers/{memberId} {
      allow read: if isAuthenticated();
      allow create: if isClub() && request.resource.data.clubId == request.auth.uid;
      allow update, delete: if (isClub() && resource.data.clubId == request.auth.uid) || isAdmin();
    }

    // ─── Player Videos ───────────────────────────────────────────────────
    match /playerVideos/{videoId} {
      allow read: if isAuthenticated();
      allow create: if isPlayer() && request.resource.data.playerId == request.auth.uid;
      allow update, delete: if (isPlayer() && resource.data.playerId == request.auth.uid) || isAdmin();
    }

    // ─── Youth Profiles (Safeguarding-Critical) ──────────────────────────
    match /youthProfiles/{userId} {
      allow read: if isOwner(userId) || isAdmin() || (isGuardian() && resource.data.get('guardianEmail', '') == request.auth.token.email);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Opportunities ───────────────────────────────────────────────────
    match /opportunities/{oppId} {
      allow read: if isAuthenticated();
      allow create: if isClub() && request.resource.data.clubId == request.auth.uid;
      allow update: if isClub() && resource.data.clubId == request.auth.uid;
      allow delete: if (isClub() && resource.data.clubId == request.auth.uid) || isAdmin();
    }

    // ─── Applications ────────────────────────────────────────────────────
    match /applications/{appId} {
      allow read: if isAuthenticated() && (
                    resource.data.playerId == request.auth.uid ||
                    resource.data.clubId == request.auth.uid ||
                    isAdmin()
                  );
      allow create: if (isPlayer() && request.resource.data.playerId == request.auth.uid) || 
                       (isClub() && request.resource.data.clubId == request.auth.uid);
      allow update: if (isClub() && resource.data.clubId == request.auth.uid) ||
                   (isPlayer() && resource.data.playerId == request.auth.uid) ||
                   isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Shortlists ──────────────────────────────────────────────────────
    match /shortlists/{shortlistId} {
      allow read: if isAuthenticated() && (resource.data.clubId == request.auth.uid || resource.data.playerId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && (request.resource.data.clubId == request.auth.uid || request.resource.data.playerId == request.auth.uid);
      allow update: if (resource.data.clubId == request.auth.uid || resource.data.playerId == request.auth.uid) || isAdmin();
      allow delete: if (resource.data.clubId == request.auth.uid || resource.data.playerId == request.auth.uid) || isAdmin();
    }

    // ─── Trials ──────────────────────────────────────────────────────────
    match /trials/{trialId} {
      allow read: if isAuthenticated() && (
                    resource.data.get('clubId', '') == request.auth.uid ||
                    resource.data.get('playerId', '') == request.auth.uid ||
                    isAdmin()
                  );
      allow create: if isClub() && request.resource.data.clubId == request.auth.uid;
      allow update: if (isClub() && resource.data.clubId == request.auth.uid) || isAdmin();
      allow delete: if (isClub() && resource.data.clubId == request.auth.uid) || isAdmin();
    }

    // ─── Notifications ───────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAdmin() || isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid &&
                    request.resource.data.diff(resource.data).affectedKeys().hasAll(['read']);
      allow delete: if isAdmin();
    }

    // ─── Messages ─────────────────────────────────────────────────────────
    match /messages/{messageId} {
      allow read: if isAuthenticated() && (
                    resource.data.senderId == request.auth.uid ||
                    resource.data.receiverId == request.auth.uid ||
                    resource.data.get('clubId', '') == request.auth.uid ||
                    isAdmin()
                  );
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // ─── Audit Logs (Immutable to normal users) ──────────────────────────
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Only via Cloud Functions / Admin SDK
    }

    // ─── Consent Audit Trail ─────────────────────────────────────────────
    match /consentAudit/{logId} {
      allow read: if isAdmin() || (isGuardian() && resource.data.guardianId == request.auth.uid);
      allow create: if isAuthenticated(); // Allow recording consent change
      allow update, delete: if false; // Immutable
    }

    // ─── Moderation Reports ───────────────────────────────────────────────
    match /moderationReports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // ─── GDPR Requests ────────────────────────────────────────────────────
    match /gdprRequests/{reqId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ─── System Configuration & Versions ──────────────────────────────────
    match /systemConfig/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /matchingConfigVersions/{versionId} {
      allow read, write: if isAdmin();
    }

    // ─── Club Verification Requests ──────────────────────────────────────
    match /clubVerificationRequests/{reqId} {
      allow read: if isOwner(reqId) || isAdmin();
      allow create: if isClub() && request.resource.data.clubId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Match Results (pre-computed scores) ─────────────────────────────
    match /matchResults/{resultId} {
      allow read: if isAuthenticated() && (
                    resource.data.playerId == request.auth.uid ||
                    resource.data.clubId == request.auth.uid ||
                    isAdmin()
                  );
      allow write: if false; // Only written by Cloud Functions
    }
  }
}
