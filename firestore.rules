rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ─── Security Foundation ─────────────────────────────────────────────
    // Deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // ─── Helper Functions ─────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      // Role stored in users/{uid}.role field
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isClub() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'club';
    }

    function isPlayer() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'player';
    }

    function isNotDisabled() {
      return !get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('disabled', false);
    }

    // ─── Users ──────────────────────────────────────────────────────────
    // Any authenticated user can read their own document; admins can read all
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if (isOwner(userId) && 
                    !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'disabled']))
                   || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Player Profiles ─────────────────────────────────────────────────
    match /players/{userId} {
      // Clubs can read searchable adult players; players read their own
      allow read: if isOwner(userId) || isAdmin() ||
                  (isClub() && resource.data.searchable == true && resource.data.get('isYouth', false) == false);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && 
                    !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified', 'adminNotes', 'score']);
      allow delete: if isAdmin();
    }

    // ─── Club Profiles ───────────────────────────────────────────────────
    match /clubs/{clubId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(clubId);
      allow update: if isOwner(clubId) && 
                    !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verificationStatus', 'verifiedAdult', 'verifiedYouth', 'adminNotes'])
                   || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Youth Profiles (Safeguarding-Critical) ──────────────────────────
    match /youthProfiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      // Only allow consent status update for the player themselves
      allow update: if isOwner(userId) ||
                    // Allow guardian consent updates only through Cloud Functions (via Admin SDK)
                    isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Opportunities ───────────────────────────────────────────────────
    match /opportunities/{oppId} {
      allow read: if isAuthenticated();
      allow create: if isClub() && request.resource.data.clubId == request.auth.uid;
      allow update: if isClub() && resource.data.clubId == request.auth.uid;
      allow delete: if (isClub() && resource.data.clubId == request.auth.uid) || isAdmin();
    }

    // ─── Applications ────────────────────────────────────────────────────
    match /applications/{appId} {
      // Players read their own applications; clubs read applications to their opportunities
      allow read: if isAuthenticated() && (
                    resource.data.playerId == request.auth.uid ||
                    resource.data.clubId == request.auth.uid ||
                    isAdmin()
                  );
      // Players create applications
      allow create: if isPlayer() && request.resource.data.playerId == request.auth.uid;
      // Clubs can update status; players cannot modify after submission
      allow update: if (isClub() && resource.data.clubId == request.auth.uid &&
                    request.resource.data.diff(resource.data).affectedKeys().hasAll(['status', 'updatedAt'])) ||
                   isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Shortlists ──────────────────────────────────────────────────────
    match /shortlists/{shortlistId} {
      allow read: if isAuthenticated() && resource.data.clubId == request.auth.uid || isAdmin();
      allow create: if isClub() && request.resource.data.clubId == request.auth.uid;
      allow update: if isClub() && resource.data.clubId == request.auth.uid;
      allow delete: if (isClub() && resource.data.clubId == request.auth.uid) || isAdmin();
    }

    // ─── Trials ──────────────────────────────────────────────────────────
    match /trials/{trialId} {
      allow read: if isAuthenticated() && (
                    resource.data.get('clubId', '') == request.auth.uid ||
                    resource.data.get('playerId', '') == request.auth.uid ||
                    isAdmin()
                  );
      allow create: if isClub() && request.resource.data.clubId == request.auth.uid;
      allow update: if (isClub() && resource.data.clubId == request.auth.uid) || isAdmin();
      allow delete: if (isClub() && resource.data.clubId == request.auth.uid) || isAdmin();
    }

    // ─── Notifications ───────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // Notifications created only by Cloud Functions (Admin SDK) or admin
      allow create: if isAdmin();
      // Users can mark their own notifications as read
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid &&
                    request.resource.data.diff(resource.data).affectedKeys().hasAll(['read']);
      allow delete: if isAdmin();
    }

    // ─── Audit Logs (Immutable to normal users) ──────────────────────────
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      // Audit logs written exclusively via Cloud Functions / Admin SDK
      allow write: if false;
    }

    // ─── Consent Audit Trail ─────────────────────────────────────────────
    match /consentAudit/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Only via Admin SDK
    }

    // ─── System Configuration ─────────────────────────────────────────────
    match /systemConfig/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── Club Verification Requests ──────────────────────────────────────
    match /clubVerificationRequests/{reqId} {
      allow read: if isOwner(reqId) || isAdmin();
      allow create: if isClub() && request.resource.data.clubId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Match Results (pre-computed scores) ─────────────────────────────
    match /matchResults/{resultId} {
      allow read: if isAuthenticated() && (
                    resource.data.playerId == request.auth.uid ||
                    resource.data.clubId == request.auth.uid ||
                    isAdmin()
                  );
      // Only written by Cloud Functions
      allow write: if false;
    }
  }
}
