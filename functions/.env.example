# ─────────────────────────────────────────────────────────────────────────────
# GROUNDWORK — Cloud Functions environment
# Set with: firebase functions:secrets:set <NAME>
# Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# AI provider selection: claude | openrouter
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Stripe (secret key + webhook signing secret)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_BOOST_7D=

# Email provider (consent invites, notifications)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=no-reply@groundwork.example

# Push notifications (optional)
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# App URL used in consent links and Stripe redirects
APP_BASE_URL=https://groundwork.example

# Video processing (Cloud Run / FFmpeg worker)
VIDEO_WORKER_URL=
VIDEO_WORKER_TOKEN=
