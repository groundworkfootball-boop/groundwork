rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    // Deny all by default
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // User profile photos and public assets
    match /users/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Player video uploads (raw & processed)
    match /videos/{userId}/{videoId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    match /playerVideos/{userId}/{videoId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Club verification and safeguarding documents (strictly club owner and admin)
    match /clubDocuments/{clubId}/{allPaths=**} {
      allow read, write: if isOwner(clubId) || isAdmin();
    }
  }
}
