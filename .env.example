# ─────────────────────────────────────────────────────────────────────────────
# GROUNDWORK — Frontend environment (Vite)
# Copy to .env and fill in. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

VITE_APP_ENV=development

# Firebase web app credentials (Project settings → Your apps → Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Cloud Functions region (must match functions deployment region)
VITE_FUNCTIONS_REGION=europe-west2

# Local emulators (development only)
VITE_USE_FIREBASE_EMULATORS=false

# Stripe publishable key (safe for the browser; secret key stays server-side)
VITE_STRIPE_PUBLIC_KEY=

# Cloudinary (all media: photos, videos, logos, documents)
# Cloud name: Cloudinary Dashboard → Account Details → Cloud name
# Upload preset: Settings → Upload → Upload presets → Add unsigned preset
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Observability / analytics (optional)
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_ONESIGNAL_APP_ID=

# Server-side account provisioning via the createAccount callable.
# Leave false on the Firebase Spark (free) plan - functions cannot be deployed.
VITE_SERVER_PROVISIONING=false
